# Unity .gitignore Template
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Last synced: 2025-12-18
# License: CC0-1.0

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender sidecar files
*.blend1
*.blend1.meta

# Memory captures and recordings
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Editor caches
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.DotSettings.user

# Gradle cache
.gradle/

# Autogenerated IDE and Unity project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash and diagnostic files
sysinfo.txt
mono_crash.*
*.stackdump
crashlytics-build.properties

# Builds and packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe
*.zip

# Test and coverage output
InitTestScene*.unity*
TestResults/
coverage/
coverage-results/
*.coverage
*.coveragexml

# Addressables generated files
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# .NET
bin/
obj/
artifacts/
.nuget/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local environment and secrets
.env
.env.*
!.env.example
*.local
secrets.json

# Feasibility prototypes: local SDKs, binaries and non-redistributable inputs
/prototypes/**/local/
/prototypes/**/external/
/prototypes/**/results/raw/
/prototypes/automation-exporter/**/*.dll
/prototypes/automation-exporter/**/*.lib
/prototypes/automation-exporter/**/*.exp
/prototypes/automation-exporter/**/*.car

# Local experiment outputs and private fixtures
/outputs/

# Replay and telemetry generated locally
*.lapreplay
*.laptelemetry
/replays/
/telemetry/
